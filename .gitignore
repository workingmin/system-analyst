# 通用 .gitignore — 适用于以 Markdown / HTML 文档为主的项目
# 保留 .md 和 .html 文件，不忽略文档内容；忽略常见的临时文件、编辑器配置、依赖目录等

# macOS
.DS_Store

# Windows
Thumbs.db

# 编辑器/IDE
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Node.js 依赖与日志（如果使用）
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Python 虚拟环境与缓存（若有）
venv/
.env
.env.*
__pycache__/
*.py[cod]
*.pyo

# 生成/构建输出、缓存和测试产物
dist/
build/
out/
.cache/
coverage/
coverage.xml

# 常见临时/备份文件
*.log
*.tmp
*.temp
*.bak
*.backup
*.swp
*.swo
*.orig

# 打包/锁文件（可按需保留）
# package-lock.json
# yarn.lock

# OS / 工具产生的隐藏文件
*.DS_Store
*.Spotlight-V100

# local environment files
.local/

# Ignore editor swap/lock files
*.lock

# If any local preview or generated HTML caches exist, ignore those specific patterns
*.cache

# ==============================================
# AI编码Agent 本地运行时/会话/缓存目录（禁止提交）
# 说明：排除各类AI编码Agent工具在项目根目录生成的不可共享本地数据
# （会话日志、缓存、运行时状态、临时快照等）；部分工具允许提交团队
# 共享的配置/技能目录，用 ! 语法豁免保留。
# 排序：按工具名（小写）字母序，便于查找与维护。
# ==============================================
# Aider（会话历史缓存）
.aider/

# Amazon Q（Q Agent运行数据）
.amazonq/

# Claude Code（排除会话/缓存，保留可共享技能目录）
.claude/
!.claude/skills/

# 腾讯 CodeBuddy（排除本地记忆与local私有配置，保留团队规则）
.codebuddy/memories/
.codebuddy/*.local.json
!.codebuddy/rules/

# Cursor Agent（本地状态、hooks缓存）
.cursor/

# Gemini CLI（排除本地缓存，保留共享配置）
.gemini/
!.gemini/settings.json

# Roo Coder（会话缓存）
.roo/

# Windsurf（工作流、本地状态缓存）
.windsurf/

# WorkBuddy（本地会话与任务运行数据）
.workbuddy/

# End of .gitignore
